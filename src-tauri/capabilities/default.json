{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "阅读树默认权限：核心 + HTTP 外发（任意标准 WebDAV；本机/局域网服务的明文 http 也放行，面板有安全提示）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**:*" }, { "url": "http://**:*" }]
    }
  ]
}
