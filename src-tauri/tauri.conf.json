{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "阅读树",
  "version": "0.4.10",
  "identifier": "com.readingtree.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "阅读树",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQUY3NkJGOTBEM0M5Q0YKUldUUHlkT1F2M2F2clNlZVM3aGxVNDZGVzRmZkNWb0M5ZllncWM2VE1aS3J5OWluOVZXdU5EZFcK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
